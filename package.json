{
  "name": "restaurant",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "packages/db",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "dotenv -e .env -- npm run dev --workspace @restaurant/api",
    "db:seed": "dotenv -e .env -- npm run seed --workspace @restaurant/db",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "prettier": "^3",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
