{
  "name": "restaurant",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "packages/db",
    "packages/contracts"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "dotenv -e .env -- npm run dev --workspace @restaurant/api",
    "start": "dotenv -e .env -- npm run start --workspace @restaurant/api --",
    "consumer": "npx --yes serve consumer --listen 5500",
    "db:seed": "dotenv -e .env -- npm run seed --workspace @restaurant/db --",
    "staff-key": "dotenv -e .env -- npm run staff-key --workspace @restaurant/db --",
    "consumer:tokens": "node -e \"require('fs').copyFileSync('design-tokens.css','consumer/design-tokens.css')\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "globals": "^16.5.0",
    "prettier": "^3",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
